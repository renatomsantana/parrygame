FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential clang git cmake pkg-config libasound2-dev libx11-dev libxi-dev \
    libxrandr-dev libxinerama-dev libxcursor-dev libgl1-mesa-dev libxtst-dev xvfb xauth zip unzip \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 6.0 https://github.com/raysan5/raylib.git /tmp/raylib \
    && cmake -S /tmp/raylib -B /tmp/raylib-build -DBUILD_SHARED_LIBS=OFF -DBUILD_EXAMPLES=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/raylib-build -j4 && cmake --install /tmp/raylib-build && ldconfig \
    && rm -rf /tmp/raylib /tmp/raylib-build
WORKDIR /check
CMD ["sh", "-c", "cp -a /src/. /check/ && cd /check/c_game && make clean && make teste-linux"]
