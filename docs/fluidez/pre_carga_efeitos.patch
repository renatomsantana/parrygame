+/* As folhas de efeito que o duelo pode pedir (o aviso de cada mestre, o choque, o erro, as ondas do selo): carregadas na abertura, e não na
+ * primeira vez que o duelo as usa. Cada uma custava de 4 a 10 ms no meio do quadro (decodificar o PNG e subir a textura), justamente no
+ * primeiro aviso de cada luta e no primeiro parry perfeito. A lista tem de acompanhar os vfx("...") e a tabela TELL deste arquivo
+ * (tests/efeitos_precarregados.sh confere). */
+static const char *const FOLHAS_DE_EFEITO[] = {"70", "64", "652", "63", "71", "184", "197", "69", "26", "14", "06", "03", "04", "195", "665"};
+static void precarrega_efeitos(void) {
+    for (size_t i = 0; i < sizeof FOLHAS_DE_EFEITO / sizeof FOLHAS_DE_EFEITO[0]; i++) spr_fx(FOLHAS_DE_EFEITO[i]);
+}
+
 int main(int argc, char **argv) {
     int startMaster = -1;
     bool direct = false;
